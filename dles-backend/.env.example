# Copy to .env and fill in your own values. .env is git-ignored.

# MySQL password for the user in database/config.json
DLES_DB_PASSWORD=

# Secret used to sign JWTs, e.g. generate with: python -c "import secrets; print(secrets.token_hex(32))"
DLES_JWT_SECRET_KEY=

# SMTP account used to send verification codes (QQ mail: sender address + SMTP authorization code)
DLES_MAIL_SENDER=
DLES_MAIL_TOKEN=


# Set to 1 when serving over HTTPS so the login cookie is only sent over HTTPS
DLES_COOKIE_SECURE=0

# Optional: Fernet key used to encrypt users' saved model API keys
# (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# If empty, a key is derived from DLES_JWT_SECRET_KEY.
DLES_ENCRYPTION_KEY=

# Set to 1 to let users point the model endpoint at localhost / private addresses (Ollama, vLLM, ...).
# Leave 0 on a shared server: the backend sends requests to whatever address the user enters.
DLES_ALLOW_PRIVATE_LLM_ENDPOINTS=0
