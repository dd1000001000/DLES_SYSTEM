# Copy to .env and fill in your own values. .env is git-ignored.

# MySQL password for the user in database/config.json
DLES_DB_PASSWORD=

# Secret used to sign JWTs, e.g. generate with: python -c "import secrets; print(secrets.token_hex(32))"
DLES_JWT_SECRET_KEY=

# SMTP account used to send verification codes (QQ mail: sender address + SMTP authorization code)
DLES_MAIL_SENDER=
DLES_MAIL_TOKEN=

# DashScope (Qwen) API key
DASHSCOPE_API_KEY=
